# Nusxa oling: cp .env.example .env
# Haqiqiy email yuborish uchun EMAIL_BACKEND ni smtp ga o'zgartiring
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
# Gmail uchun "App Password" ishlatiladi (oddiy parol emas)
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=Online Shop <your_email@gmail.com>
